{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JomarJunior/miraveja-ecosystem/specs/003-cofrealma-persona-definition/contracts/author-note-v1.schema.json",
  "title": "MiraVeja author's note, format version 1",
  "description": "Team-only lore about what really happened. Lives beside definitions in the private vault; no runtime ever reads it (FR-031 to FR-033).",
  "type": "object",
  "additionalProperties": false,
  "required": ["miravejaAuthorNote", "nature", "about", "truth", "writtenBy", "writtenOn"],
  "properties": {
    "miravejaAuthorNote": { "const": 1 },
    "nature": { "enum": ["resident", "synthetic"] },
    "about": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "persona": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "story": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
        "seedMemory": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" }
      },
      "anyOf": [{ "required": ["persona"] }, { "required": ["story"] }],
      "dependentRequired": { "seedMemory": ["persona"] }
    },
    "truth": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "writtenBy": { "type": "string", "minLength": 1, "maxLength": 80 },
    "writtenOn": { "type": "string", "format": "date" }
  }
}
